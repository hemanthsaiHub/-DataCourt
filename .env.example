# Copy to .env (never commit .env). You need just ONE of these three free keys.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional: choose the preferred provider (gemini | groq | openrouter)
LLM_PROVIDER=gemini

# Optional: override default models if a provider renames or retires one
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Upload limit in MB (Vercel request bodies max out around 4.5 MB)
MAX_UPLOAD_MB=4
